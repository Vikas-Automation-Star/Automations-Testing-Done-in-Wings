    <test name="MastersAndNodesCreationAndNavigation" description="Creating Masters,Nodes and Moving " testID="3">
        <classes>
            <class name="phase_1_TestCases.MastersConfiguration"></class>
        </classes>
    </test>

    <test name="VoucherTypesAndSeries" description="VoucherTypes,Manual VoucherTypes,Multiple VoucherTypes" testID="3">
        <classes>
            <class name="phase_1_TestCases.VoucherTypesAndSeries"></class>
