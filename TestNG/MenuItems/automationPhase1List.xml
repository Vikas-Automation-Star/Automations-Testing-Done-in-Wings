<suite name="CompanyCreation, configure Company And Masters Importing">

    <listeners>
        <listener class-name="com.wings.utils.Listener"></listener>
<!--        <listener class-name="util.AnnotationTransformer"/>-->
    </listeners>


    <test name="CompanyCreationAlongWithConfigurations" description="description for BranchMaster" testID="1">
        <classes>
            <class name="util.CompanyInitilizatonGSTconfig"></class>
        </classes>
    </test>

    <test name="MastersAndPropertiesImporting" description="importing Branches,Customers,Suppliers,Products,BankAccount,CashAccount,HSN Codes" testID="2">
