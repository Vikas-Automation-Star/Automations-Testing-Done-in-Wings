<suite name="Audit- Reports">

    <listeners>
        <listener class-name="com.wings.utils.listener"/>
    </listeners>

    <test name="Deleted Transaction">
        <classes>
            <class name="menuItems.audit.reports.DeletedTransactionsReport"/>
        </classes>
    </test>

    <test name="Voucher Statistics">
        <classes>
            <class name="menuItems.audit.reports.VoucherStatisticsReport"/>
        </classes>
    </test>

    <test name="Login status">
        <classes>
            <class name="menuItems.audit.reports.LoginStatusReport"/>
        </classes>
    </test>

    <test name="Transaction Activity">
        <classes>
            <class name="menuItems.audit.reports.TransactionActivityLogReport"/>
        </classes>
    </test>

    <test name="Deleted Transactiones">
        <classes>
            <class name="menuItems.audit.reports.DeletedTransactionesReport"/>
        </classes>
    </test>

    <test name="Void Transactiones">
        <classes>
            <class name="menuItems.audit.reports.VoidTransactionesReport"/>
        </classes>
    </test>

    <test name="Voucher History">
        <classes>
            <class name="menuItems.audit.reports.VoucherHistoryReport"/>
        </classes>
    </test>

</suite>