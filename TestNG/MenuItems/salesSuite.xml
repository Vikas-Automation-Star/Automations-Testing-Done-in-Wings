    <test name="SEC 1" description="Sales Enquiry Cancellation" testID="3">
        <classes>
            <class name="menuItems.sales.transactions.TestSalesEnquiryCancellation"/>
        </classes>
    </test>

    <test name="SQ 1" description="Sales Quotation" testID="4">
        <classes>
            <class name="menuItems.sales.transactions.SalesQuotationTransaction"/>
        </classes>
    </test>

    <test name="SQC 1" description="Sales Quotation Cancellation" testID="5">
        <classes>
            <class name="menuItems.sales.transactions.SalesQuotationsCancellationTransaction"/>
